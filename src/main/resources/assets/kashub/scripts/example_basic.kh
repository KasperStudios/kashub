// Kashub Basic Example - V2 Syntax
// Demonstrates core features of the v2 engine

print "=== Kashub V2 Basic Example ==="

// Variables
let health = player.getHealth()
let pos = player.getPos()

print "Current Health: " + health
print "Position: X=" + pos.x + " Y=" + pos.y + " Z=" + pos.z

// Conditional logic
if (health < 10) {
    print "⚠ Low health detected!"
} else {
    print "✓ Health is good"
}

// Simple loop
print "Counting to 5..."
let i = 0
while (i < 5) {
    print "Count: " + i
    i = i + 1
    wait 500
}

print "=== Example Complete ==="
