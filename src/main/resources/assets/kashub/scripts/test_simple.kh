print "Position X: " + pos.x
print "Position Y: " + pos.y
print "Position Z: " + pos.z

// Test 4: Inventory
print "Test 4: Checking inventory..."
let empty = inventory.getEmptySlots()
print "Empty slots: " + empty

print "=== All Tests Complete ==="
