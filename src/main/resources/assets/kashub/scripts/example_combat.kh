// Kashub Combat Automation - V2 Syntax
// Automated combat with targeting and healing

print "=== Combat Automation ==="

// Configure combat settings
let combatRange = 4
let healThreshold = 10
let escapeHealth = 5

print "Combat range: " + combatRange + " blocks"
print "Heal threshold: " + healThreshold + " HP"
print "Escape threshold: " + escapeHealth + " HP"

while (true) {
    // Check health first
    let health = player.getHealth()
    
    if (health <= escapeHealth) {
        print "Critical health! Escaping..."
        player.chat("/spawn")
        break
    }
    
    if (health <= healThreshold) {
        print "Low health, eating food..."
        inventory.use("golden_apple")
        wait 1000
        continue
    }
    
    // Look for enemies
    let enemy = vision.nearest("hostile", combatRange)
    
    if (enemy != null) {
        print "Target acquired: " + enemy.type
        print "Distance: " + enemy.distance
        
        // Move toward enemy
        player.moveTo(enemy.pos.x, enemy.pos.y, enemy.pos.z)
        wait 500
        
        // Attack
        player.attack()
        print "Attacking!"
        
        // Face enemy
        player.lookAt(enemy.pos.x, enemy.pos.y, enemy.pos.z)
    } else {
        print "No enemies nearby"
    }
    
    wait 1000
}

print "Combat ended"