// Kashub Mining Automation - V2 Syntax  
// Smart ore detection and mining

print("=== Auto Miner Starting ===")

// Configuration
let searchRadius = 32
let targetOres = ["diamond_ore", "ancient_debris", "emerald_ore", "gold_ore"]
let maxOres = 20
let safetyHealth = 8

print("Search radius: " + searchRadius)
print("Target ores: " + targetOres.length())
print("Safety health: " + safetyHealth)

fn findNearestOre() {
    // Scan for all target ores
    for (let i = 0; i < targetOres.length(); i = i + 1) {
        let oreName = targetOres[i]
        let ores = scanner.blocks(oreName, searchRadius)
        
        if (ores.length() > 0) {
            return ores[0]  // Return nearest
        }
    }
    return null
}

fn checkSafety() {
    let health = player.getHealth()
    let hunger = player.getHunger()
    
    if (health < safetyHealth) {
        print("⚠ Low health! Eating...")
        inventory.use("golden_apple")
        wait(2000)
        return false
    }
    
    if (hunger < 6) {
        print("⚠ Low hunger! Eating...")
        inventory.use("cooked_beef")
        wait(1000)
    }
    
    // Check for nearby dangers
    let hostiles = vision.count("hostile", 10)
    if (hostiles > 0) {
        print("⚠ " + hostiles + " hostiles nearby!")
        return false
    }
    
    return true
}

fn mineOre(ore) {
    let pos = ore.pos
    print("Mining " + ore.block + " at " + pos.x + ", " + pos.y + ", " + pos.z)
    
    // Navigate to ore
    player.moveTo(pos.x, pos.y, pos.z)
    wait(500)
    
    // Look at ore and mine
    player.lookAt(pos.x, pos.y, pos.z)
    wait(200)
    
    // Select pickaxe
    let pickaxe = inventory.find("diamond_pickaxe")
    if (!pickaxe.found) {
        pickaxe = inventory.find("iron_pickaxe")
    }
    
    if (pickaxe.found) {
        inventory.selectSlot(pickaxe.slot)
    }
    
    // Break the ore
    player.breakBlock()
    wait(1000)
    
    print("✓ Mined " + ore.block)
}

// Main mining loop
let mined = 0
let cycles = 0
let maxCycles = 50

while (mined < maxOres && cycles < maxCycles) {
    cycles = cycles + 1
    print("\n--- Cycle " + cycles + " ---")
    
    // Safety check
    if (!checkSafety()) {
        print("Unsafe conditions! Waiting...")
        wait(5000)
        continue
    }
    
    // Find ore
    let ore = findNearestOre()
    
    if (ore == null) {
        print("No ores found. Moving to new area...")
        let pos = player.getPos()
        player.moveTo(pos.x + 16, pos.y, pos.z)
        wait(2000)
        continue
    }
    
    // Mine the ore
    mineOre(ore)
    mined = mined + 1
    
    // Check inventory
    let invCheck = inventory.check()
    if (invCheck.full) {
        print("\n⚠ Inventory full! Stopping.")
        break
    }
    
    print("Progress: " + mined + "/" + maxOres)
    wait(1000)
}

// Final stats
print("\n=== Mining Complete ===")
print("Total mined: " + mined + " ores")
print("Cycles: " + cycles)

// Count valuable ores
let diamonds = inventory.count("diamond")
let emeralds = inventory.count("emerald")
let gold = inventory.count("gold_ingot")

print("\n--- Loot Summary ---")
print("Diamonds: " + diamonds.amount)
print("Emeralds: " + emeralds.amount)  
print("Gold: " + gold.amount)

let finalHealth = player.getHealth()
print("\nFinal health: " + finalHealth + "/20")
